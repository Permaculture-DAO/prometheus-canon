{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prometheus:schema:controlled-source-release:1.0",
  "title": "PROMETHEUS ControlledSourceRelease",
  "type": "object",
  "required": [
    "source_id",
    "version",
    "authority_class",
    "sha256",
    "status",
    "timestamp"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "authority_class": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canon_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "upstream_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "PROPOSED",
        "ACTIVE",
        "SUPERSEDED",
        "HISTORICAL",
        "RETIRED"
      ]
    },
    "signer": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "registry_uri": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}