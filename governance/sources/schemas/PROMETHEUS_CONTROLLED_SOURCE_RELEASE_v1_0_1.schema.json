{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prometheus:schema:controlled-source-release:1.0.1",
  "title": "PROMETHEUS ControlledSourceRelease",
  "type": "object",
  "required": [
    "source_id",
    "version",
    "authority_class",
    "sha256",
    "canon_version",
    "upstream_hashes",
    "supersedes",
    "status",
    "signer",
    "timestamp",
    "registry_uri",
    "authoritative"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "authority_class": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canon_version": {
      "const": "v1.1.2-genesis"
    },
    "upstream_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "PROPOSED",
        "ACTIVE",
        "SUPERSEDED",
        "HISTORICAL",
        "RETIRED"
      ]
    },
    "signer": {
      "type": "string",
      "pattern": "^[A-F0-9]{40}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "registry_uri": {
      "type": "string",
      "format": "uri"
    },
    "authoritative": {
      "const": false
    }
  },
  "additionalProperties": false,
  "description": "Candidate future transport record. Fields/signers are structural claims, not verified signatures, governance admission or scientific/legal/capital authority. No hApp migration performed."
}
