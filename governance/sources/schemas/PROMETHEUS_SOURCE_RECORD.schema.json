{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prometheus:schema:source-record:1.0",
  "title": "PROMETHEUS Source Record",
  "type": "object",
  "required": [
    "source_id",
    "version",
    "authority_class",
    "status",
    "sha256",
    "scope"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "authority_class": {
      "type": "string",
      "minLength": 1
    },
    "authority_dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "PROPOSED",
        "ACTIVE",
        "ACTIVE_SUPPORTING",
        "SUPERSEDED",
        "HISTORICAL",
        "HISTORICAL_EVIDENCE_SNAPSHOT",
        "RETIRED"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "upstream": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permitted_use": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prohibited_interpretation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}